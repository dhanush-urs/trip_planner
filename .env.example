# =============================================================================
# TripForge — Environment Variables
# Copy to .env before running:
#   cp .env.example .env
#
# REAL DATA STACK (recommended):
#   - Geoapify: destination search + hotel discovery (free tier, 3000 req/day)
#   - OpenTripMap: attractions/POIs (free tier)
#   - OpenRouteService: route optimization (free tier, 2000 req/day)
#   - Foursquare: optional hotel/POI search (free tier)
#
# NOT USED: Amadeus (requires OAuth2+billing), Aviationstack (flights only)
# =============================================================================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=tripforge
DB_USERNAME=tripforge_user
DB_PASSWORD=tripforge_pass

JWT_SECRET=TripForge-Super-Secret-Key-2024-Must-Be-At-Least-256-Bits-Long!!
JWT_EXPIRATION_MS=86400000

EUREKA_URL=http://discovery-server:8761/eureka/
REDIS_HOST=redis
REDIS_PORT=6379

DISCOVERY_PORT=8761
GATEWAY_PORT=8080
AUTH_PORT=8081
TRIP_PORT=8082
HOTEL_PORT=8083
ROUTE_PORT=8084
BUDGET_PORT=8085
SPLIT_PORT=8086
ML_PORT=8087
EXTERNAL_DATA_PORT=8088
AI_ORCHESTRATOR_PORT=8089
PAYMENT_SERVICE_PORT=8090
FRONTEND_PORT=3000

ML_WEIGHT=0.65
RULE_WEIGHT=0.35

# =============================================================================
# REAL DATA PROVIDERS
# =============================================================================

# Geoapify — PRIMARY for destination search + hotel discovery
# Free tier: 3,000 req/day | https://www.geoapify.com/
GEOAPIFY_API_KEY=660e0145da2244538f54ba0fd7d54b3a
GEOAPIFY_ENABLED=true

# OpenTripMap — PRIMARY for attractions/POIs
# Free tier | https://opentripmap.io/product
OPENTRIPMAP_API_KEY=5ae2e3f221c38a28845f05b6c41f86abf84de6d6108eef50451094a4
OPENTRIPMAP_ENABLED=true

# OpenRouteService — PRIMARY for route optimization
