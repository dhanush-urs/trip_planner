# =============================================================================
# TripForge — Root Environment Variables
# Copy to .env before running docker-compose:
#   cp .env.example .env
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tripforge
DB_USERNAME=tripforge_user
DB_PASSWORD=tripforge_pass

# ── JWT ───────────────────────────────────────────────────────────────────────
# IMPORTANT: Change this in production. Must be >= 256 bits (32+ chars).
JWT_SECRET=TripForge-Super-Secret-Key-2024-Must-Be-At-Least-256-Bits-Long!!
JWT_EXPIRATION_MS=86400000

# ── Eureka ────────────────────────────────────────────────────────────────────
EUREKA_URL=http://discovery-server:8761/eureka/

# ── Service Ports ─────────────────────────────────────────────────────────────
DISCOVERY_PORT=8761
GATEWAY_PORT=8080
AUTH_PORT=8081
TRIP_PORT=8082
HOTEL_PORT=8083
ROUTE_PORT=8084
BUDGET_PORT=8085
SPLIT_PORT=8086
ML_PORT=8087
FRONTEND_PORT=3000

# ── JPA ───────────────────────────────────────────────────────────────────────
JPA_DDL_AUTO=validate

# ── ML Service ────────────────────────────────────────────────────────────────
ML_WEIGHT=0.65
RULE_WEIGHT=0.35
