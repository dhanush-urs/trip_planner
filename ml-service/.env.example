# TripForge ML Service — Environment Variables

# App settings
APP_NAME=TripForge ML Service
APP_VERSION=1.0.0
DEBUG=false

# Model paths (relative to ml-service root)
HOTEL_RANKER_PATH=saved_models/hotel_ranker.pkl
TRIP_CLASSIFIER_PATH=saved_models/trip_style_classifier.pkl
FEATURE_METADATA_PATH=saved_models/feature_metadata.json

# Hybrid scoring weights (must sum to 1.0)
ML_WEIGHT=0.65
RULE_WEIGHT=0.35
